<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <AssemblyName>Termule.Playground</AssemblyName>
        <RootNamespace>Termule.Playground</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Engine\Engine.csproj"/>
    </ItemGroup>

    <!-- Stop StyleCop from requiring documentation -->
    <PropertyGroup>
        <NoWarn>$(NoWarn);SA0001</NoWarn>
    </PropertyGroup>
</Project>
