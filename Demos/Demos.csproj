<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <AssemblyName>Termule.Demos</AssemblyName>
        <RootNamespace>Termule.Demos</RootNamespace>
        <PublishSingleFile>true</PublishSingleFile>
    </PropertyGroup>

    <PropertyGroup>
        <Authors>Veop</Authors>
        <PackageId>Termule.Demos</PackageId>
        <Description>The demo collection for the Termule game engine.</Description>
        <!-- <PackageReadmeFile>README.md</PackageReadmeFile>         -->
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/V30P/termule</RepositoryUrl>
        <PackageTags>terminal;console;game-engine;ascii</PackageTags>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>termule-demos</ToolCommandName>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Engine\Engine.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="res\**\*">
            <!-- Makes sure resource paths are the same on all systems -->
            <LogicalName>res/$([System.String]::Copy('%(RecursiveDir)%(Filename)%(Extension)').Replace('\', '/'))</LogicalName>
        </EmbeddedResource>
    </ItemGroup>

    <!-- Stop StyleCop from requiring documentation -->
    <PropertyGroup>
        <NoWarn>$(NoWarn);SA0001</NoWarn>
    </PropertyGroup>

</Project>
