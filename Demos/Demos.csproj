<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <AssemblyName>Termule.Demos</AssemblyName>
        <RootNamespace>Termule.Demos</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Engine\Engine.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="res\**\*">
            <!-- Make sure resource paths are the same on all systems -->
            <LogicalName>res/$([System.String]::Copy('%(RecursiveDir)%(Filename)%(Extension)').Replace('\', '/'))</LogicalName>
        </EmbeddedResource>
    </ItemGroup>

    <!-- Stop StyleCop from requiring documentation -->
    <PropertyGroup>
        <NoWarn>$(NoWarn);SA0001</NoWarn>
    </PropertyGroup>

    <PropertyGroup>
        <Authors>Veop</Authors>
        <PackageId>Termule.Demos</PackageId>
        <Description>The demo collection for the Termule SDK.</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>        
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/V30P/termule</RepositoryUrl>
        <PackageTags>terminal;console;games;demo</PackageTags>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>termule-demos</ToolCommandName>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="" />
    </ItemGroup>

</Project>
