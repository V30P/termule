{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "buildDemos",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/Demos/Demos.csproj"
      ]
    },
    {
      "label": "serveDocs",
      "type": "shell",
      "command": "docfx docs/docfx.json --serve",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "docfx",
          "endsPattern": "Serving"
        }
      }
    },
    {
      "label": "stopDocs",
      "type": "shell",
      "command": "pkill -f 'docfx.*--serve' || true",
      "problemMatcher": []
    }
  ]
}